# Normalize line endings at commit time so the repo is the same on Windows, macOS and Linux.
# Working trees still get what each platform needs; the committed blob is LF.
* text=auto eol=lf

# Windows-only scripts must stay CRLF or cmd.exe / some PowerShell hosts misread them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX scripts must stay LF or the shebang line breaks.
*.sh text eol=lf

# Plain-text formats Git would otherwise guess wrong (or that have no safe heuristic).
*.svg text
*.md text
*.json text
*.yml text
*.yaml text
*.ini text
*.cfg text
*.txt text
*.html text
*.css text
*.js text

# Binary formats: no conversion, no text diff. These are also what `.gitignore` keeps out of the
# repo in day-to-day work; the rules stay because docs/images and model exports may be committed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
*.sqlite binary
*.sqlite3 binary
*.gguf binary
*.onnx binary
*.bin binary
*.safetensors binary
*.wav binary
*.mp3 binary
*.ogg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
